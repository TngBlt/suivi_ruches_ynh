#!/bin/bash

#=================================================
# GENERIC START
#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# Save the API key as a setting (encrypted by default for password type)
ynh_app_setting_set --key=anthropic_api_key --value="$anthropic_api_key"

#=================================================
# INSTALL NODE.JS
#=================================================
ynh_script_progression "Installing Node.js..."

ynh_nodejs_install

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir"

#=================================================
# REORGANIZE FILES
#=================================================
ynh_script_progression "Organizing app files..."

# Suivi Ruches has files in src/ subfolder
# Create index.html from the versioned HTML file so express.static serves it
if [ -d "$install_dir/src" ]; then
    if [ -f "$install_dir/src/suivi-ruches-v1.4.0.html" ]; then
        cp "$install_dir/src/suivi-ruches-v1.4.0.html" "$install_dir/src/index.html"
    fi
    
    # Patch server.js to use PORT environment variable instead of hardcoded 3000
    # This makes it compatible with YunoHost's dynamic port allocation
    sed -i 's/const PORT = 3000;/const PORT = process.env.PORT || 3000;/' "$install_dir/src/server.js"
fi

chown -R "$app:www-data" "$install_dir"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

# Create the .env file from template
ynh_config_add --template=".env" --destination="$install_dir/.env"

# Set permissions on .env (sensitive: contains API key)
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# INSTALL NPM DEPENDENCIES
#=================================================
ynh_script_progression "Installing app dependencies..."

# Install npm dependencies as the app user
pushd "$install_dir"
    ynh_exec_as_app $ynh_node_load_PATH $ynh_npm install --production
popd

#=================================================
# CREATE LOG DIRECTORY
#=================================================
ynh_script_progression "Creating log directory..."

mkdir -p "/var/log/$app"
chown -R "$app:$app" "/var/log/$app"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config
ynh_config_add_nginx

# Create a dedicated systemd config
ynh_config_add_systemd

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

# Register the service with YunoHost
yunohost service add "$app" --description="Suivi Ruches - Beekeeping monitoring app" --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start the app
ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="🐝 Apiculture App disponible"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
